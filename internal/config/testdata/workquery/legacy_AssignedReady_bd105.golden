sh -c 'gc_eph_fetch_inprog() { [ -n "${gc_eph_inprog_set:-}" ] || { gc_eph_inprog=$(bd query --json '\''ephemeral=true AND status=in_progress'\'' --limit=0 2>/dev/null); gc_eph_inprog_set=1; }; }; gc_eph_fetch_open() { [ -n "${gc_eph_open_set:-}" ] || { gc_eph_open=$(bd query --json '\''ephemeral=true AND status=open'\'' --limit=0 2>/dev/null); gc_eph_open_set=1; }; }; for id in "$GC_SESSION_ID" "$GC_SESSION_NAME" "$GC_ALIAS"; do [ -z "$id" ] && continue; legacy=""; case "$id" in *control-dispatcher) legacy="${id%control-dispatcher}workflow-control";; esac; for cand in "$id" "$legacy"; do [ -z "$cand" ] && continue; r=$(bd ready --include-ephemeral --assignee="$cand" --json --limit=1 2>/dev/null); [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; done; done; printf "[]"'